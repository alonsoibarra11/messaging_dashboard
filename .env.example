# Ver docs/specs/variables-entorno.md. Copiar a .env.local. Nunca commitear .env.local.

# Destino de los rewrites /api/v1/* (servidor)
BACKEND_URL=http://localhost:8000
# Base del WebSocket (cliente)
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1
# "enabled" activa MSW en el navegador (FE-02)
NEXT_PUBLIC_API_MOCKING=
# FE-13
NEXT_PUBLIC_SENTRY_DSN=
